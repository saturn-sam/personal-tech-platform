---
import type { CollectionEntry } from 'astro:content';

import Card from '@components/ui/card.astro';
import Tag from '@components/ui/tag.astro';
import Badge from '@components/ui/badge.astro';
import Button from '@components/ui/button.astro';
import Chip from '@components/ui/chip.astro';
import Link from '@components/ui/link.astro';
import Grid from '@components/layout/grid.astro';
import Section from '@components/layout/section.astro';
import PageContainer from '@components/layout/page-container.astro';
import Stack from '@components/layout/stack.astro';
import PersonSchema from '@components/seo/person-schema.astro';
import WebsiteSchema from '@components/seo/website-schema.astro';
import { homepageConfig } from '@config/homepage';
import AppLayout from '@layouts/app-layout.astro';
import {
  getPublishedCollectionEntries,
  getPublishedKnowledgeAssets,
  sortByUpdatedDate,
  type KnowledgeAssetEntry,
} from '@lib/content/queries';

const {
  seo,
  hero,
  locale,
  sections: {
    featuredKnowledge: featuredKnowledgeConfig,
    featuredProjects: featuredProjectsConfig,
    technologyOverview: technologyOverviewConfig,
    certifications: certificationsConfig,
    recentUpdates: recentUpdatesConfig,
  },
} = homepageConfig;

type HomepageKnowledgeCollection = (typeof featuredKnowledgeConfig.collections)[number];
type HomepageKnowledgeEntry = CollectionEntry<HomepageKnowledgeCollection>;

const homepageKnowledgeCollections = new Set<string>(featuredKnowledgeConfig.collections);
const isHomepageKnowledgeEntry = (entry: KnowledgeAssetEntry): entry is HomepageKnowledgeEntry =>
  homepageKnowledgeCollections.has(entry.collection);

const getAssetPath = (entry: KnowledgeAssetEntry): string =>
  entry.data.seo.canonicalPath ?? `/${entry.collection}/${entry.data.slug}/`;

const formatDate = (date: Date): string =>
  new Intl.DateTimeFormat(locale, {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(date);

const featuredKnowledge: HomepageKnowledgeEntry[] = (await getPublishedKnowledgeAssets())
  .filter(isHomepageKnowledgeEntry)
  .filter((entry) => entry.data.featured)
  .slice(0, featuredKnowledgeConfig.limit);

const featuredProjects = (await getPublishedCollectionEntries('projects'))
  .filter((entry) => entry.data.featured)
  .slice(0, featuredProjectsConfig.limit);

const technologies = (await getPublishedCollectionEntries('technologies')).filter(
  (entry) => entry.data.featured,
);

const technologyGroups = technologyOverviewConfig.categories
  .map((category) => ({
    category,
    entries: technologies.filter((entry) => entry.data.categories.includes(category)),
  }))
  .filter((group) => group.entries.length > 0);

const certifications = (await getPublishedCollectionEntries('certifications'))
  .filter((entry) => entry.data.featured)
  .slice(0, certificationsConfig.limit);

const recentEntries = sortByUpdatedDate([
  ...(await getPublishedCollectionEntries('articles')),
  ...(await getPublishedCollectionEntries('lab-notes')),
])
  .filter((entry) => entry.data.featured)
  .slice(0, recentUpdatesConfig.limit);
---

<AppLayout
  title={seo.title}
  description={seo.description}
  canonicalPath={seo.canonicalPath}
  mainClass="homepage"
>
  <WebsiteSchema />
  <PersonSchema />
  <Section spacing="spacious">
    <PageContainer size="wide">
      <div class="homepage-hero">
        <Stack gap="lg" class="homepage-hero__content">
          <Stack gap="sm">
            <p class="homepage-hero__eyebrow">{hero.name}</p>
            <h1 class="homepage-hero__title">{hero.title}</h1>
            <p class="homepage-hero__intro">{hero.introduction}</p>
          </Stack>

          <div class="homepage-hero__actions" aria-label={hero.actionsLabel}>
            <Button href={hero.primaryAction.href}>{hero.primaryAction.label}</Button>
            <Button href={hero.secondaryAction.href} variant="secondary">
              {hero.secondaryAction.label}
            </Button>
          </div>
        </Stack>
      </div>
    </PageContainer>
  </Section>

  <Section spacing="compact" ariaLabel={featuredKnowledgeConfig.title}>
    <PageContainer size="wide">
      <Stack gap="lg">
        <div class="homepage-section-header">
          <h2>{featuredKnowledgeConfig.title}</h2>
          <p>{featuredKnowledgeConfig.description}</p>
        </div>

        <Grid columns={2}>
          {
            featuredKnowledge.map((entry) => (
              <Card as="article" variant="interactive">
                <Stack gap="sm">
                  <Badge tone="accent">
                    {featuredKnowledgeConfig.collectionLabels[entry.collection]}
                  </Badge>
                  <h3 class="homepage-card__title">
                    <a class="homepage-card__link" href={getAssetPath(entry)}>
                      {entry.data.title}
                    </a>
                  </h3>
                  <p class="homepage-card__description">{entry.data.description}</p>
                  <div class="homepage-card__meta">
                    {entry.data.technologies.slice(0, 3).map((technology) => (
                      <Tag>{technology}</Tag>
                    ))}
                  </div>
                </Stack>
              </Card>
            ))
          }
        </Grid>
      </Stack>
    </PageContainer>
  </Section>

  <Section spacing="compact" ariaLabel={featuredProjectsConfig.title}>
    <PageContainer size="wide">
      <Stack gap="lg">
        <div class="homepage-section-header">
          <h2>{featuredProjectsConfig.title}</h2>
          <p>{featuredProjectsConfig.description}</p>
        </div>

        <Grid columns={3}>
          {
            featuredProjects.map((entry) => (
              <Card as="article" variant="interactive">
                <Stack gap="sm">
                  <Badge>
                    {featuredProjectsConfig.statusLabel}: {entry.data.projectStatus}
                  </Badge>
                  <h3 class="homepage-card__title">
                    <a class="homepage-card__link" href={getAssetPath(entry)}>
                      {entry.data.title}
                    </a>
                  </h3>
                  <p class="homepage-card__description">{entry.data.description}</p>
                  <div class="homepage-card__meta">
                    {entry.data.technologies.slice(0, 3).map((technology) => (
                      <Tag>{technology}</Tag>
                    ))}
                  </div>
                  <Link href={getAssetPath(entry)} variant="standalone">
                    {featuredProjectsConfig.linkLabel}
                  </Link>
                </Stack>
              </Card>
            ))
          }
        </Grid>
      </Stack>
    </PageContainer>
  </Section>

  <Section spacing="compact" ariaLabel={technologyOverviewConfig.title}>
    <PageContainer size="wide">
      <Stack gap="lg">
        <div class="homepage-section-header">
          <h2>{technologyOverviewConfig.title}</h2>
          <p>{technologyOverviewConfig.description}</p>
        </div>

        <Grid columns={3}>
          {
            technologyGroups.map((group) => (
              <Card>
                <Stack gap="sm">
                  <h3 class="homepage-card__title">{group.category}</h3>
                  <div class="homepage-chip-list">
                    {group.entries.map((entry) => (
                      <Chip href={getAssetPath(entry)}>{entry.data.title}</Chip>
                    ))}
                  </div>
                </Stack>
              </Card>
            ))
          }
        </Grid>
      </Stack>
    </PageContainer>
  </Section>

  <Section spacing="compact" ariaLabel={certificationsConfig.title}>
    <PageContainer size="wide">
      <Stack gap="lg">
        <div class="homepage-section-header">
          <h2>{certificationsConfig.title}</h2>
          <p>{certificationsConfig.description}</p>
        </div>

        <Grid columns={4}>
          {
            certifications.map((entry) => (
              <Card as="article" variant="interactive">
                <Stack gap="sm">
                  <h3 class="homepage-card__title">
                    <a class="homepage-card__link" href={getAssetPath(entry)}>
                      {entry.data.title}
                    </a>
                  </h3>
                  <p class="homepage-card__description">
                    {certificationsConfig.issuerLabel}: {entry.data.issuer}
                  </p>
                  <div class="homepage-card__meta">
                    {entry.data.skills.slice(0, 2).map((skill) => (
                      <Tag>{skill}</Tag>
                    ))}
                  </div>
                  <Link href={getAssetPath(entry)} variant="standalone">
                    {certificationsConfig.linkLabel}
                  </Link>
                </Stack>
              </Card>
            ))
          }
        </Grid>
      </Stack>
    </PageContainer>
  </Section>

  <Section spacing="compact" ariaLabel={recentUpdatesConfig.title}>
    <PageContainer size="wide">
      <Stack gap="lg">
        <div class="homepage-section-header">
          <h2>{recentUpdatesConfig.title}</h2>
          <p>{recentUpdatesConfig.description}</p>
        </div>

        <div class="homepage-update-list">
          {
            recentEntries.map((entry) => (
              <article class="homepage-update">
                <div>
                  <h3 class="homepage-update__title">
                    <a class="homepage-card__link" href={getAssetPath(entry)}>
                      {entry.data.title}
                    </a>
                  </h3>
                  <p class="homepage-update__description">{entry.data.summary}</p>
                </div>
                <p class="homepage-update__date">
                  {recentUpdatesConfig.updatedLabel} {formatDate(entry.data.updatedDate)}
                </p>
              </article>
            ))
          }
        </div>
      </Stack>
    </PageContainer>
  </Section>
</AppLayout>
