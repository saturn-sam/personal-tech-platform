---
import { getLinkPrefetchStrategy } from '@utils/prefetch';

export interface Props {
  class?: string;
  href?: string;
  selected?: boolean;
}

const { class: className = '', href, selected = false } = Astro.props as Props;
const classes = ['ui-chip', selected && 'ui-chip--selected', className];
const prefetchStrategy = getLinkPrefetchStrategy(href);
---

{
  href ? (
    <a
      class:list={classes}
      href={href}
      aria-current={selected ? 'true' : undefined}
      data-astro-prefetch={prefetchStrategy}
    >
      <slot />
    </a>
  ) : (
    <span class:list={classes}>
      <slot />
    </span>
  )
}
