---
export interface Props {
  alt?: string;
  class?: string;
  name: string;
  size?: 'sm' | 'md' | 'lg';
  src?: string;
}

const { alt, class: className = '', name, size = 'md', src } = Astro.props as Props;

const initials = name
  .trim()
  .split(/\s+/)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase() ?? '')
  .join('');
---

<span class:list={['ui-avatar', `ui-avatar--${size}`, className]}>
  {
    src ? (
      <img class="ui-avatar__image" src={src} alt={alt ?? name} loading="lazy" decoding="async" />
    ) : (
      <span class="ui-avatar__initials" aria-hidden="true">
        {initials}
      </span>
    )
  }
  {!src && <span class="sr-only">{name}</span>}
</span>
