---
import { getLinkPrefetchStrategy } from '@utils/prefetch';

export interface Props {
  class?: string;
  href?: string;
}

const { class: className = '', href } = Astro.props as Props;
const classes = ['ui-tag', className];
const prefetchStrategy = getLinkPrefetchStrategy(href);
---

{
  href ? (
    <a class:list={classes} href={href} data-astro-prefetch={prefetchStrategy}>
      <slot />
    </a>
  ) : (
    <span class:list={classes}>
      <slot />
    </span>
  )
}
