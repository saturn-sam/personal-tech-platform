---
import Card from '@components/ui/card.astro';
import Grid from '@components/layout/grid.astro';
import type { AboutData } from '@lib/content/about';

import AboutSectionHeader from './about-section-header.astro';

interface Props {
  id: string;
  section: AboutData['personalInterests'] | AboutData['currentFocus'];
}

const { id, section } = Astro.props as Props;
const columns: 2 | 3 = section.groups.length >= 3 ? 3 : 2;
---

<section class="about-section about-groups" aria-labelledby={id}>
  <AboutSectionHeader id={id} title={section.title} intro={section.intro} />

  <Grid columns={columns} gap="lg" class="about-group-grid">
    {
      section.groups.map((group) => (
        <Card as="section" class="about-group-card">
          <h3>{group.title}</h3>
          <ul class="about-group-list">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </Card>
      ))
    }
  </Grid>
</section>
