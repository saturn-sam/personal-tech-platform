---
export interface Props {
  class?: string;
  label?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { class: className = '', label = 'Loading', size = 'md' } = Astro.props as Props;
---

<span class:list={['loading-indicator', `loading-indicator--${size}`, className]} role="status">
  <span class="loading-indicator__mark" aria-hidden="true"></span>
  <span class="loading-indicator__label">{label}</span>
</span>
