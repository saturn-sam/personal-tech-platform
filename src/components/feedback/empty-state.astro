---
import Button from '@components/ui/button.astro';

export interface Props {
  actionHref?: string;
  actionLabel?: string;
  class?: string;
  description?: string;
  title: string;
}

const { actionHref, actionLabel, class: className = '', description, title } = Astro.props as Props;

const slugify = (value: string): string =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const titleId = `${slugify(title)}-empty-title`;
---

<section class:list={['empty-state', className]} aria-labelledby={titleId}>
  <div class="empty-state__body">
    <h2 class="empty-state__title" id={titleId}>{title}</h2>
    {description && <p class="empty-state__description">{description}</p>}
    {
      actionHref && actionLabel && (
        <div class="empty-state__action">
          <Button href={actionHref} variant="secondary">
            {actionLabel}
          </Button>
        </div>
      )
    }
  </div>
</section>
