---
export interface Props {
  codeCopiedLabel?: string;
  codeCopyLabel?: string;
  mermaidTitle?: string;
}

const {
  codeCopiedLabel = 'Copied',
  codeCopyLabel = 'Copy',
  mermaidTitle = 'Mermaid diagram',
} = Astro.props as Props;
---

<div
  data-markdown-enhancements
  data-code-copied-label={codeCopiedLabel}
  data-code-copy-label={codeCopyLabel}
  data-mermaid-title={mermaidTitle}
  hidden
>
</div>

<div id="reading-progress" class="reading-progress" aria-hidden="true"></div>

<script>
  import '../../scripts/content-runtime';
</script>
