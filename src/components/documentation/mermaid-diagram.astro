---
export interface Props {
  class?: string;
  definition: string;
  description?: string;
  title: string;
}

const { class: className = '', definition, description, title } = Astro.props as Props;

const slugify = (value: string): string =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const diagramId = `mermaid-diagram-${slugify(title)}`;
const captionId = `${diagramId}-caption`;
const hintId = `${diagramId}-hint`;
---

<figure class:list={['mermaid-diagram', className]} data-mermaid-diagram data-mermaid-title={title}>
  <figcaption class="mermaid-diagram__caption" id={captionId}>
    <span class="mermaid-diagram__title">{title}</span>
    {description && <span class="mermaid-diagram__description">{description}</span>}
  </figcaption>
  <p class="sr-only" id={hintId}>Scroll horizontally to review the Mermaid source definition.</p>
  <pre
    class="mermaid-diagram__source"
    data-mermaid-source
    tabindex="0"
    role="region"
    aria-labelledby={captionId}
    aria-describedby={hintId}><code>{definition}</code></pre>
  <div class="mermaid-diagram__canvas" data-mermaid-canvas hidden></div>
</figure>
