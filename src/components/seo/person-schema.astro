---
import { siteConfig } from '@config/site';

export interface Props {
  description?: string;
  url?: string;
}

const { description = siteConfig.description, url = `${siteConfig.url}/about/` } = Astro.props;

const sameAs = siteConfig.socialLinks
  .map((link) => link.href)
  .filter((href) => /^https?:\/\//.test(href))
  .filter((href) => !['https://github.com/', 'https://www.linkedin.com/'].includes(href));

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  description,
  name: siteConfig.author,
  ...(sameAs.length > 0 ? { sameAs } : {}),
  url,
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
