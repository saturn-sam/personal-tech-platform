---
interface PaginationTarget {
  readonly href: string;
  readonly label?: string;
}

export interface Props {
  class?: string;
  currentPage?: number;
  first?: PaginationTarget;
  label?: string;
  last?: PaginationTarget;
  next?: PaginationTarget;
  previous?: PaginationTarget;
  totalPages?: number;
}

const {
  class: className = '',
  currentPage,
  first,
  label = 'Pagination',
  last,
  next,
  previous,
  totalPages,
} = Astro.props as Props;
---

<nav class:list={['pagination', className]} aria-label={label}>
  <ul class="pagination__list">
    <li>
      {
        first ? (
          <a class="pagination__link" href={first.href}>
            {first.label ?? 'First'}
          </a>
        ) : (
          <span class="pagination__link pagination__link--disabled" aria-disabled="true">
            First
          </span>
        )
      }
    </li>
    <li>
      {
        previous ? (
          <a class="pagination__link" href={previous.href}>
            {previous.label ?? 'Previous'}
          </a>
        ) : (
          <span class="pagination__link pagination__link--disabled" aria-disabled="true">
            Previous
          </span>
        )
      }
    </li>
    {
      currentPage && totalPages && (
        <li class="pagination__status" aria-current="page">
          Page {currentPage} of {totalPages}
        </li>
      )
    }
    <li>
      {
        next ? (
          <a class="pagination__link" href={next.href}>
            {next.label ?? 'Next'}
          </a>
        ) : (
          <span class="pagination__link pagination__link--disabled" aria-disabled="true">
            Next
          </span>
        )
      }
    </li>
    <li>
      {
        last ? (
          <a class="pagination__link" href={last.href}>
            {last.label ?? 'Last'}
          </a>
        ) : (
          <span class="pagination__link pagination__link--disabled" aria-disabled="true">
            Last
          </span>
        )
      }
    </li>
  </ul>
</nav>
