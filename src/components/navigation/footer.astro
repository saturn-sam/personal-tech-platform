---
import { siteConfig } from '@config/site';
import { getLinkPrefetchStrategy } from '@utils/prefetch';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__meta">
      <p class="site-footer__title">{siteConfig.fullName}</p>
      <p class="site-footer__text">{siteConfig.footer.description}</p>
      <p class="site-footer__text">
        {siteConfig.footer.builtWithLabel}
        {' '}
        {siteConfig.footer.designedForLabel}
      </p>
      <p class="site-footer__text">
        {`${siteConfig.footer.copyrightLabel} ${currentYear} ${siteConfig.author}.`}
      </p>
    </div>

    <div class="site-footer__navigation">
      <nav class="site-footer__groups" aria-label={siteConfig.footer.navigationLabel}>
        {
          siteConfig.footer.sections.map((section) => (
            <section class="site-footer__group">
              <h2 class="site-footer__group-title">{section.title}</h2>
              <ul class="site-footer__link-list">
                {section.links.map((link) => (
                  <li>
                    <a
                      class="site-footer__link"
                      href={link.href}
                      data-astro-prefetch={getLinkPrefetchStrategy(link.href)}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
