---
import { primaryNavigation } from '@config/navigation';
import { siteConfig } from '@config/site';
import NavigationMenu from './navigation-menu.astro';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__meta">
      <p class="site-footer__title">{siteConfig.fullName}</p>
      <p class="site-footer__text">{siteConfig.footer.description}</p>
      <p class="site-footer__text">
        {siteConfig.footer.copyrightLabel}
        {currentYear}
        {siteConfig.author}.
      </p>
    </div>

    <div class="site-footer__navigation">
      <NavigationMenu
        currentPath={Astro.url.pathname}
        items={primaryNavigation}
        label={siteConfig.footer.navigationLabel}
        variant="mobile"
      />
      <nav class="site-footer__links" aria-label={siteConfig.footer.linksLabel}>
        <ul class="site-footer__link-list">
          {
            siteConfig.footer.links.map((link) => (
              <li>
                <a class="site-footer__link" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</footer>
