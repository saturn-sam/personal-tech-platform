---
import ThemeToggle from '@components/utility/theme-toggle.astro';
import NavigationMenu from './navigation-menu.astro';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__inner">
    <div class="site-header__desktop">
      <NavigationMenu currentPath={currentPath} />
    </div>

    <div class="site-header__actions">
      <ThemeToggle />
      <div class="site-header__mobile mobile-navigation">
        <button
          class="mobile-navigation__toggle"
          type="button"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-navigation-panel"
        >
          <span aria-hidden="true">Menu</span>
        </button>
        <div id="mobile-navigation-panel" class="mobile-navigation__panel" hidden>
          <NavigationMenu
            currentPath={currentPath}
            label="Mobile primary navigation"
            variant="mobile"
          />
        </div>
      </div>
    </div>
  </div>
</header>
