---
export interface Props {
  class?: string;
  copiedLabel?: string;
  label?: string;
  targetId?: string;
  text?: string;
}

const {
  class: className = '',
  copiedLabel = 'Copied',
  label = 'Copy',
  targetId,
  text,
} = Astro.props as Props;

const disabled = !targetId && !text;
const statusId = targetId ? `${targetId}-copy-status` : undefined;
---

<button
  class:list={['copy-button', className]}
  type="button"
  data-copy-button
  data-copy-target={targetId}
  data-copy-text={text}
  data-copy-label={label}
  data-copy-copied-label={copiedLabel}
  disabled={disabled}
  aria-label={label}
  aria-controls={targetId}
  aria-describedby={statusId}
>
  <span data-copy-button-label>{label}</span>
</button>
<span class="sr-only" id={statusId} role="status" aria-live="polite" data-copy-button-status></span>
