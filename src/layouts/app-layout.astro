---
import Footer from '@components/navigation/footer.astro';
import Header from '@components/navigation/header.astro';
import { siteConfig } from '@config/site';
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
  mainClass?: string;
}

const {
  title = siteConfig.fullName,
  description = siteConfig.description,
  mainClass = '',
} = Astro.props;

const pageTitle = title === siteConfig.fullName ? title : `${title} | ${siteConfig.name}`;

const themeInitScript = `
(() => {
  const storageKey = 'ptkp-theme';
  const validThemes = ['light', 'dark', 'system'];
  const root = document.documentElement;

  const getPreference = () => {
    try {
      const storedTheme = localStorage.getItem(storageKey);
      return validThemes.includes(storedTheme) ? storedTheme : 'system';
    } catch {
      return 'system';
    }
  };

  const resolveTheme = (preference) => {
    if (preference === 'system') {
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    return preference;
  };

  const preference = getPreference();
  root.dataset.themePreference = preference;
  root.dataset.theme = resolveTheme(preference);
})();
`;
---

<!doctype html>
<html lang={siteConfig.language} data-theme="light" data-theme-preference="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <script is:inline set:html={themeInitScript} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <Header />
      <main id="main-content" class:list={['site-main', mainClass]}>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
