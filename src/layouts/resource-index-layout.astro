---
import Badge from '@components/ui/badge.astro';
import Card from '@components/ui/card.astro';
import Tag from '@components/ui/tag.astro';
import EmptyState from '@components/feedback/empty-state.astro';
import Grid from '@components/layout/grid.astro';
import PageContainer from '@components/layout/page-container.astro';
import Section from '@components/layout/section.astro';
import Stack from '@components/layout/stack.astro';
import Breadcrumb from '@components/navigation/breadcrumb.astro';
import { resourceConfig } from '@config/resources';
import AppLayout from '@layouts/app-layout.astro';
import {
  formatResourceDate,
  formatResourceMachineDate,
  formatResourceType,
  getResourceBreadcrumbs,
  getResourceUrl,
  type ResourceGroup,
} from '@lib/content/resources';

interface Props {
  groups: readonly ResourceGroup[];
}

const { groups } = Astro.props as Props;
const labels = resourceConfig.labels;
const breadcrumbs = getResourceBreadcrumbs();
const getCategoryId = (category: string): string =>
  `resource-category-${category.toLocaleLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<AppLayout
  title={resourceConfig.seoTitle}
  description={resourceConfig.seoDescription}
  canonicalPath={resourceConfig.routeBase}
  mainClass="resource-index-page"
>
  <Section spacing="spacious" class="resource-index">
    <PageContainer size="wide">
      <Stack gap="lg">
        <Breadcrumb items={breadcrumbs} />

        <header class="resource-index__header">
          <Badge tone="accent">{resourceConfig.badgeLabel}</Badge>
          <h1>{resourceConfig.indexTitle}</h1>
          <p>{resourceConfig.indexDescription}</p>
        </header>

        {
          groups.length > 0 ? (
            <div class="resource-groups">
              {groups.map((group) => (
                <section class="resource-group" aria-labelledby={getCategoryId(group.category)}>
                  <header class="resource-group__header">
                    <h2 id={getCategoryId(group.category)}>{group.category}</h2>
                    <p>
                      {group.entries.length} {group.entries.length === 1 ? 'resource' : 'resources'}
                    </p>
                  </header>

                  <Grid as="ul" columns={3} gap="lg" class="resource-index__grid">
                    {group.entries.map((entry) => {
                      const href = entry.data.seo.canonicalPath ?? getResourceUrl(entry.data.slug);

                      return (
                        <Card as="li" variant="interactive" class="resource-card">
                          <article class="resource-card__article">
                            <Stack gap="sm">
                              <div class="resource-card__meta-row">
                                <Badge size="sm">
                                  {formatResourceType(entry.data.resourceType)}
                                </Badge>
                                <span>
                                  <time
                                    datetime={formatResourceMachineDate(entry.data.updatedDate)}
                                  >
                                    {formatResourceDate(entry.data.updatedDate)}
                                  </time>
                                </span>
                              </div>
                              <h3 class="resource-card__title">
                                <a class="resource-card__link" href={href}>
                                  {entry.data.title}
                                </a>
                              </h3>
                              <p class="resource-card__description">{entry.data.description}</p>
                              <dl class="resource-card__metadata">
                                <div>
                                  <dt>{labels.difficulty}</dt>
                                  <dd>{entry.data.difficulty}</dd>
                                </div>
                                <div>
                                  <dt>{labels.estimatedStudyTime}</dt>
                                  <dd>{entry.data.estimatedStudyTime}</dd>
                                </div>
                              </dl>
                              <div class="resource-card__tags" aria-label={labels.technologies}>
                                {entry.data.technologies.slice(0, 3).map((technology) => (
                                  <Tag>{technology}</Tag>
                                ))}
                              </div>
                            </Stack>
                          </article>
                        </Card>
                      );
                    })}
                  </Grid>
                </section>
              ))}
            </div>
          ) : (
            <EmptyState
              title={resourceConfig.emptyTitle}
              description={resourceConfig.emptyDescription}
            />
          )
        }
      </Stack>
    </PageContainer>
  </Section>
</AppLayout>
