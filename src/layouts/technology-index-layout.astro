---
import Badge from '@components/ui/badge.astro';
import Card from '@components/ui/card.astro';
import Tag from '@components/ui/tag.astro';
import EmptyState from '@components/feedback/empty-state.astro';
import Grid from '@components/layout/grid.astro';
import PageContainer from '@components/layout/page-container.astro';
import Section from '@components/layout/section.astro';
import Stack from '@components/layout/stack.astro';
import Breadcrumb from '@components/navigation/breadcrumb.astro';
import { technologyConfig } from '@config/technologies';
import AppLayout from '@layouts/app-layout.astro';
import {
  formatTechnologyDate,
  formatTechnologyMachineDate,
  getTechnologyBreadcrumbs,
  getTechnologyUrl,
  type TechnologyGroup,
} from '@lib/content/technologies';

interface Props {
  groups: readonly TechnologyGroup[];
}

const { groups } = Astro.props as Props;
const labels = technologyConfig.labels;
const breadcrumbs = getTechnologyBreadcrumbs();
const getCategoryId = (category: string): string =>
  `technology-category-${category.toLocaleLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<AppLayout
  title={technologyConfig.seoTitle}
  description={technologyConfig.seoDescription}
  canonicalPath={technologyConfig.routeBase}
  mainClass="technology-index-page"
>
  <Section spacing="spacious" class="technology-index">
    <PageContainer size="wide">
      <Stack gap="lg">
        <Breadcrumb items={breadcrumbs} />

        <header class="technology-index__header">
          <h1>{technologyConfig.indexTitle}</h1>
          <p>{technologyConfig.indexDescription}</p>
        </header>

        {
          groups.length > 0 ? (
            <div class="technology-groups">
              {groups.map((group) => (
                <section class="technology-group" aria-labelledby={getCategoryId(group.category)}>
                  <header class="technology-group__header">
                    <h2 id={getCategoryId(group.category)}>{group.category}</h2>
                    <p>
                      {group.entries.length}{' '}
                      {group.entries.length === 1 ? 'technology' : 'technologies'}
                    </p>
                  </header>

                  <Grid as="ul" columns={3} gap="lg" class="technology-index__grid">
                    {group.entries.map((entry) => {
                      const href =
                        entry.data.seo.canonicalPath ?? getTechnologyUrl(entry.data.slug);

                      return (
                        <Card as="li" variant="interactive" class="technology-card">
                          <article class="technology-card__article">
                            <Stack gap="sm">
                              <div class="technology-card__meta-row">
                                <Badge size="sm">{entry.data.skillLevel}</Badge>
                                <span>
                                  <time
                                    datetime={formatTechnologyMachineDate(entry.data.updatedDate)}
                                  >
                                    {formatTechnologyDate(entry.data.updatedDate)}
                                  </time>
                                </span>
                              </div>
                              <h3 class="technology-card__title">
                                <a class="technology-card__link" href={href}>
                                  {entry.data.title}
                                </a>
                              </h3>
                              <p class="technology-card__description">{entry.data.description}</p>
                              <dl class="technology-card__metadata">
                                {entry.data.vendor && (
                                  <div>
                                    <dt>{labels.vendor}</dt>
                                    <dd>{entry.data.vendor}</dd>
                                  </div>
                                )}
                                <div>
                                  <dt>{labels.category}</dt>
                                  <dd>{group.category}</dd>
                                </div>
                              </dl>
                              <div class="technology-card__tags" aria-label={labels.tags}>
                                {entry.data.tags.slice(0, 4).map((tag) => (
                                  <Tag>{tag}</Tag>
                                ))}
                              </div>
                            </Stack>
                          </article>
                        </Card>
                      );
                    })}
                  </Grid>
                </section>
              ))}
            </div>
          ) : (
            <EmptyState
              title={technologyConfig.emptyTitle}
              description={technologyConfig.emptyDescription}
            />
          )
        }
      </Stack>
    </PageContainer>
  </Section>
</AppLayout>
