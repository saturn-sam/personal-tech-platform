{
  "name": "personal-tech-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static-first personal technical knowledge platform built with Astro.",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "postbuild": "npm run validate:production",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro sync && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "validate:production": "node scripts/production/harden-dist.mjs",
    "lint-staged": "lint-staged",
    "validate": "npm run check && npm run typecheck && npm run lint && npm run format:check && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.3",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.9",
    "mermaid": "^11.16.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}
